# RC Car dashboard — FastAPI app on port 80.
# Install (paths assume the repo is cloned at /home/pi/car):
#   sudo cp ~/car/pi/webapp/car-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now car-dashboard
# Logs: journalctl -u car-dashboard -f

[Unit]
Description=RC Car dashboard (FastAPI/uvicorn)
After=network-online.target pigpiod.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/car/pi
ExecStart=/home/pi/car/pi/.venv/bin/python -m uvicorn webapp.server:app --host 0.0.0.0 --port 80
# Lets a non-root process bind port 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
